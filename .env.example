# MotoConnect — Configuración de entorno
PORT=3000
NODE_ENV=development
DEMO_MODE=true

# PayPal REST API (Sandbox o Live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# WhatsApp Atención al Cliente
WHATSAPP_NUMBER=+59167671435

# Envío de documentos PDF por correo
# En Render plan gratuito (puerto SMTP 465/587 bloqueado) usa BREVO_API_KEY por HTTPS (puerto 443)
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Asesor Técnico y Soporte IA (Groq)
GROQ_API_KEY=
